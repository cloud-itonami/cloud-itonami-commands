{:paths ["src" "resources" "dist"]
 ;; The command surface of cloud-itonami-app as a dependency, in two forms:
 ;;
 ;;   dist/commands.wasm, dist/repo_profile.wasm   the Kotoba components (amu,
 ;;                                                wasm32, JVM-free build; the
 ;;                                                host they run under is beside
 ;;                                                them: dist/browser-host.mjs)
 ;;   src/cloud/itonami/app/*.cljk                 the Clojure ORACLES, kept
 ;;                                                until every consumer has cut
 ;;                                                over (parity gate:
 ;;                                                test/kotoba_parity_nbb.cljk)
 ;;
 ;; No JVM dependency: nothing here declares org.clojure/clojure, a Maven
 ;; coordinate, or a JVM test runner. The one library is kotoba-lang/text, for
 ;; the oracles; the sha is an explicit floor, the same one the consumers pin.
 :deps {
        ;; kotoba.http.form-urlencoded replaced java.net.URLEncoder/URLDecoder here
        ;; (2026-09-24). An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/http-parse-url
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "3dfb77e29a541416bfd6a39aee202ab770ddf952"
         :deps/root "lib/kotoba.http"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.coll"}
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.text"}}}
