{:paths ["src" "resources" "dist"]
 ;; The command surface of cloud-itonami-app as a dependency, in two forms:
 ;;
 ;;   dist/commands.wasm, dist/repo_profile.wasm   the Kotoba components (amu,
 ;;                                                wasm32, JVM-free build; the
 ;;                                                host they run under is beside
 ;;                                                them: dist/browser-host.mjs)
 ;;   src/cloud/itonami/app/*.cljk                 the Clojure ORACLES, kept
 ;;                                                until every consumer has cut
 ;;                                                over (parity gate:
 ;;                                                test/kotoba_parity_nbb.cljk)
 ;;
 ;; No JVM dependency: nothing here declares org.clojure/clojure, a Maven
 ;; coordinate, or a JVM test runner. The one library is kotoba-lang/text, for
 ;; the oracles; the sha is an explicit floor, the same one the consumers pin.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}}
