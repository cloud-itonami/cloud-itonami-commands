    0 (document-edn-read "[{:command [\"auth\" \"login\"], :method :post, :template \"/api/agent-session\", :body {:enrollment-key {:enrollment-key true}, :label {:flag :label, :default \"cli\"}, :user-id {:flag :user-id}, :organization-id {:flag :organization}, :ttl-days {:flag :ttl-days, :parse :long}}, :stores-token? true} {:command [\"auth\" \"status\"], :method :get, :template \"/api/agent-session\"} {:command [\"auth\" \"revoke\"], :method :post, :template \"/api/agent-session/{id}/revoke\", :params [{:name \"id\", :flag :id, :required? true, :hint \"auth status で確認できます\"}]} {:command [\"tenant\" \"list\"], :method :get, :template \"/v1/tenants\"} {:command [\"tenant\" \"connections\"], :method :get, :template \"/v1/tenant-connections\"} {:command [\"tenant\" \"connect\"], :method :post, :template \"/v1/tenant-connections\", :body {:tenant_id {:flag :tenant}, :agent_id {:flag :agent-id}, :capabilities {:flag :cap, :parse :comma-list}, :ttl_seconds {:flag :ttl-seconds, :parse :long}, :budget {:max_operations {:flag :max-operations, :parse :long}, :max_storage_bytes {:flag :max-storage-bytes, :parse :long}}, :idempotency_key {:flag :idempotency-key}}} {:command [\"tenant\" \"status\"], :method :get, :template \"/v1/tenant-connections/{connection}\", :params [{:name \"connection\", :flag :connection, :required? true}]} {:command [\"tenant\" \"renew\"], :method :post, :template \"/v1/tenant-connections/{connection}/renew\", :params [{:name \"connection\", :flag :connection, :required? true}], :body {:ttl_seconds {:flag :ttl-seconds, :parse :long}}}]")
    1 (document-edn-read "[{:command [\"tenant\" \"revoke\"], :method :post, :template \"/v1/tenant-connections/{connection}/revoke\", :params [{:name \"connection\", :flag :connection, :required? true}]} {:command [\"tenant\" \"context\"], :method :post, :template \"/v1/tenant-connections/{connection}/context\", :params [{:name \"connection\", :flag :connection, :required? true}], :body {:capability {:flag :capability}}} {:command [\"tenant\" \"repository-read\"], :method :get, :template \"/v1/tenant-connections/{connection}/repository\", :params [{:name \"connection\", :flag :connection, :required? true}]} {:command [\"tenant\" \"repository-write\"], :method :post, :template \"/v1/tenant-connections/{connection}/repository\", :params [{:name \"connection\", :flag :connection, :required? true}], :body {:state_edn {:flag :file, :required? true, :parse :file-contents}, :expected_cid {:flag :expected-cid}}} {:command [\"tenant\" \"repository-publish\"], :method :post, :template \"/v1/tenant-connections/{connection}/repository/publish\", :params [{:name \"connection\", :flag :connection, :required? true}]} {:command [\"business\" \"list\"], :method :get, :template \"/api/business\"} {:command [\"business\" \"create\"], :method :post, :template \"/api/business\", :body {:slug {:flag :slug}, :name {:flag :name}, :note {:flag :note}}} {:command [\"business\" \"bind\"], :method :post, :template \"/api/business/{id}/bind\", :params [{:name \"id\", :flag :id, :required? true}], :body {:repos {:flag :repos, :parse :comma-list}, :adoptions {:flag :adoptions, :parse :comma-list}, :canvas {:flag :canvas}, :model {:flag :model}, :leverage {:flag :leverage}, :lei {:flag :lei}}, :requires-one-of [:repos :adoptions :canvas :model :leverage :lei]}]")
    2 (document-edn-read "[{:command [\"bots\" \"list\"], :method :get, :template \"/api/agent-bots\"} {:command [\"bots\" \"workforce\"], :method :get, :template \"/api/agent-bots/workforce\"} {:command [\"bots\" \"provision\"], :method :post, :template \"/api/agent-bots/workforce/provision\", :timeout-seconds 120} {:command [\"bots\" \"messages\"], :method :get, :template \"/api/agent-bots/{id}/messages\", :params [{:name \"id\", :flag :id, :required? true}]} {:command [\"bots\" \"model\"], :method :post, :template \"/api/agent-bots/{id}/model\", :params [{:name \"id\", :flag :id, :required? true}], :body {:provider-id {:flag :provider, :required? true}, :model {:flag :model, :required? true}}} {:command [\"bots\" \"task\"], :method :post, :template \"/api/agent-bots/{id}/messages\", :params [{:name \"id\", :flag :id, :required? true}], :body {:text {:flag :text, :required? true}}, :timeout-seconds 660} {:command [\"bots\" \"handoff\"], :method :post, :template \"/api/agent-bots/{from}/handoff\", :params [{:name \"from\", :flag :from, :required? true}], :body {:to {:flag :to, :required? true}, :task {:flag :task, :required? true}, :depth {:flag :depth, :parse :long}}, :timeout-seconds 660} {:command [\"bots\" \"decide\"], :method :post, :template \"/api/agent-bots/{id}/cards/{card}/decide\", :params [{:name \"id\", :flag :id, :required? true} {:name \"card\", :flag :card, :required? true}], :body {:decision {:flag :decision, :required? true}}, :timeout-seconds 660}]")
    3 (document-edn-read "[{:command [\"bots\" \"cancel\"], :method :post, :template \"/api/agent-bots/{id}/messages/{run}/cancel\", :params [{:name \"id\", :flag :id, :required? true} {:name \"run\", :flag :run, :required? true}]} {:command [\"bots\" \"rename\"], :method :post, :template \"/api/agent-bots/{id}/name\", :params [{:name \"id\", :flag :id, :required? true}], :body {:name {:flag :name}, :by {:flag :by}, :restore {:flag :restore, :parse :boolish}}} {:command [\"bots\" \"trajectory\"], :method :get, :template \"/api/agent-bots/{id}/runs/{run}/trajectory\", :params [{:name \"id\", :flag :id, :required? true} {:name \"run\", :flag :run, :required? true}]} {:command [\"itonami\" \"profile\" \"list\"], :method :get, :template \"/api/profiles\"} {:command [\"itonami\" \"session\" \"list\"], :method :get, :template \"/p/{profile}/api/sessions\", :params [{:name \"profile\", :flag :profile, :default \"default\"}]} {:command [\"itonami\" \"session\" \"messages\"], :method :get, :template \"/p/{profile}/api/sessions/{session}/messages\", :params [{:name \"profile\", :flag :profile, :default \"default\"} {:name \"session\", :flag :session, :required? true}]} {:command [\"itonami\" \"run\"], :method :post, :template \"/p/{profile}/v1/runs\", :params [{:name \"profile\", :flag :profile, :default \"default\"}], :body {:input {:flag :input, :required? true}, :instructions {:flag :instructions}, :goal {:flag :goal, :parse :boolish}}} {:command [\"itonami\" \"run-status\"], :method :get, :template \"/v1/runs/{run}\", :params [{:name \"run\", :flag :run, :required? true}]}]")
    4 (document-edn-read "[{:command [\"itonami\" \"steer\"], :method :post, :template \"/v1/runs/{run}/steer\", :params [{:name \"run\", :flag :run, :required? true}], :body {:input {:flag :input, :required? true}}} {:command [\"itonami\" \"stop\"], :method :post, :template \"/v1/runs/{run}/stop\", :params [{:name \"run\", :flag :run, :required? true}]} {:command [\"itonami\" \"approve\"], :method :post, :template \"/v1/runs/{run}/approval\", :params [{:name \"run\", :flag :run, :required? true}], :body {:choice {:flag :choice, :default \"once\"}}}]")
    (document-null)))

(defn alias-chunk [c :i64] :document
  (case (quot c 16)
    0 (alias-chunk-c0 c)
    (document-null)))

(defn host-side-count [] :i64 3)
(defn- host-side-chunks [] :i64 1)

(defn- host-side-chunk-c0 [c :i64] :document
  (case c
    0 (document-edn-read "[{:command [\"bots\" \"hygiene\"], :why \"reads west metadata on this machine; there is no route to call\"} {:command [\"bots\" \"refactor\" \"scan\"], :why \"west refactor scan is host-side\"} {:command [\"bots\" \"refactor\" \"inspect\"], :why \"west refactor inspect is host-side\"}]")
    (document-null)))

(defn host-side-chunk [c :i64] :document
  (case (quot c 16)
    0 (host-side-chunk-c0 c)
    (document-null)))


;; ---------------------------------------------------------------------------
;; tables: chunks of eight commands, each one EDN document
;;
;; `table` selects which generated table answers: 0 registry, 1 aliases,
;; 2 host-side. A closure would do the same with one fewer parameter and one
;; more dispatch; a small integer is the plainer of the two.
;; ---------------------------------------------------------------------------

(defn- table-count [table :i64] :i64
  (case table 0 (registry-count) 1 (alias-count) 2 (host-side-count) 0))

(defn- table-chunks [table :i64] :i64
  (case table 0 (registry-chunks) 1 (alias-chunks) 2 (host-side-chunks) 0))

(defn- table-chunk [table :i64 c :i64] :document
  (case table 0 (registry-chunk c) 1 (alias-chunk c) 2 (host-side-chunk c) (document-null)))

(defn- table-at [table :i64 i :i64] :document
  (at-or-null (table-chunk table (quot i 8)) (mod i 8)))

(defn registry-at [i :i64] :document (table-at 0 i))
(defn alias-at [i :i64] :document (table-at 1 i))
(defn host-side-at [i :i64] :document (table-at 2 i))

(defn- command-words [command :document] :document (get-or-null command :command))

(defn- prefix-of? [cmd-words :document ws :document j :i64] :bool
  (if (>= j (document-count cmd-words))
    true
    (if (string=? (str-at cmd-words j) (str-at ws j))
      (prefix-of? cmd-words ws (+ j 1))
      false)))

;; the index of the longest command in `table` whose words prefix `ws`, or -1.
;; Longest wins because `workspace drive documents` and `workspace drive
;; documents rename` are both commands. Ties keep the earlier entry, as the
;; oracle's stable sort did. Walked chunk by chunk so each chunk is read once.
;;
;; The running best is one integer, `index * 8 + arity` (arity < 8, -1 for
;; none): a function takes at most five parameters here, and the pair would
;; have been the sixth.
(defn- best-index [packed :i64] :i64 (if (< packed 0) -1 (quot packed 8)))
(defn- best-arity [packed :i64] :i64 (if (< packed 0) 0 (mod packed 8)))

(defn- longest-in-chunk [chunk :document ws :document base :i64 k :i64 packed :i64] :i64
  (if (>= k (document-count chunk))
    packed
    (let [cw (command-words (at-or-null chunk k))
          arity (document-count cw)]
      (if (and (<= arity (document-count ws))
               (> arity (best-arity packed))
               (prefix-of? cw ws 0))
        (longest-in-chunk chunk ws base (+ k 1) (+ (* (+ base k) 8) arity))
        (longest-in-chunk chunk ws base (+ k 1) packed)))))

(defn- longest-from [table :i64 ws :document c :i64 packed :i64] :i64
  (if (>= c (table-chunks table))
    (best-index packed)
    (longest-from table ws (+ c 1)
                  (longest-in-chunk (table-chunk table c) ws (* c 8) 0 packed))))

(defn- longest-in [table :i64 ws :document] :i64
  (longest-from table ws 0 -1))

(defn- rest-from [ws :document i :i64 acc :document] :document
  (if (>= i (document-count ws))
    acc
    (rest-from ws (+ i 1) (document-vector-conj acc (at-or-null ws i)))))

(defn- registry-arity [i :i64] :i64 (document-count (command-words (registry-at i))))

;; `{:command … :rest …}` for these words, or `{}`.
(defn resolve-command [ws :document] :document
  (let [i (longest-in 0 ws)]
    (if (< i 0)
      (document-map)
      (document-assoc (document-assoc (document-map) :command (registry-at i))
                      :rest (rest-from ws (registry-arity i) (document-vector))))))

;; the alias these words name, or null
(defn resolve-alias [ws :document] :document
  (let [i (longest-in 1 ws)]
    (if (< i 0) (document-null) (alias-at i))))

;; the host-side command these words name, or null. Named separately so a
;; front end can refuse `bots hygiene` as "this one does not go through the
;; server" rather than as "no such command".
(defn host-side [ws :document] :document
  (let [i (longest-in 2 ws)]
    (if (< i 0) (document-null) (host-side-at i))))

;; What these argv words mean, as data. Aliases win over the generated
;; registry; `:host-side` and `:unknown` are distinct outcomes.
(defn resolve-invocation [argv :document] :document
  (let [ws (words argv)
        flags (parse-flags argv)
        base (document-assoc (document-assoc (document-map) :flags flags) :words ws)
        a (longest-in 1 ws)]
    (if (>= a 0)
      (document-assoc (document-assoc base :kind (document-keyword :alias)) :command (alias-at a))
      (let [h (longest-in 2 ws)]
        (if (>= h 0)
          (document-assoc (document-assoc base :kind (document-keyword :host-side)) :command (host-side-at h))
          (let [c (longest-in 0 ws)]
            (if (>= c 0)
              (document-assoc
               (document-assoc
                (document-assoc base :kind (document-keyword :registry))
                :command (registry-at c))
               :rest (rest-from ws (registry-arity c) (document-vector)))
              (document-assoc base :kind (document-keyword :unknown)))))))))

;; ---------------------------------------------------------------------------
;; names, usage, search
;; ---------------------------------------------------------------------------

(defn- join-from [v :document sep :string i :i64 acc :string] :string
  (if (>= i (document-count v))
    acc
    (join-from v sep (+ i 1)
               (if (= i 0) (str-at v i) (cat3 acc sep (str-at v i))))))

(defn command-name [command :document] :string
  (join-from (get-or-null command :command) " " 0 ""))

(defn- params-usage [params :document i :i64 acc :string] :string
  (if (>= i (count-or-zero params))
    acc
    (let [nm (get-str (at-or-null params i) :name "")]
      (params-usage params (+ i 1) (string-concat acc (cat4 " --" nm " <" (string-concat nm ">")))))))

(defn- flags-usage [flags :document i :i64 acc :string] :string
  (if (>= i (count-or-zero flags))
    acc
    (flags-usage flags (+ i 1) (string-concat acc (cat3 " [--" (str-at flags i) " <value>]")))))

;; One line of help for a command: its name, then the flags it is known to take.
(defn usage [command :document] :string
  (cat3 (command-name command)
        (params-usage (get-or-null command :params) 0 "")
        (flags-usage (get-or-null command :flags) 0 "")))

(defn- blank? [s :string] :bool
  ;; whitespace-only, as str/blank?: every code point is ASCII space or below
  (loop [i 0]
    (if (>= i (string-length s))
      true
      (let [cp (string-code-point-at s i)]
        (if (<= cp 32) (recur (+ i (cp-width cp))) false)))))

(defn- every-term-in? [nm :string terms :document i :i64] :bool
  (if (>= i (document-count terms))
    true
    (let [t (string-fold-case (str-at terms i))]
      (if (blank? t)
        (every-term-in? nm terms (+ i 1))
        (if (string-contains? nm t)
          (every-term-in? nm terms (+ i 1))
          false)))))

(defn- matches? [command :document terms :document] :bool
  (every-term-in? (string-fold-case (command-name command)) terms 0))

(defn- match-count-in-chunk [chunk :document terms :document k :i64 n :i64] :i64
  (if (>= k (document-count chunk))
    n
    (match-count-in-chunk chunk terms (+ k 1) (if (matches? (at-or-null chunk k) terms) (+ n 1) n))))

(defn- match-count-from [terms :document c :i64 n :i64] :i64
  (if (>= c (registry-chunks))
    n
    (match-count-from terms (+ c 1) (match-count-in-chunk (registry-chunk c) terms 0 n))))

;; Commands whose name contains every one of `terms`; empty terms means all.
;; Answered as a count and an nth because a result list of 211 does not fit a
;; document; the caller walks 0..count.
(defn match-count [terms :document] :i64
  (match-count-from terms 0 0))

;; the `want`-th match, scanning chunk by chunk; `seen` counts matches so far.
(defn- match-in-chunk [chunk :document terms :document want :i64 k :i64 seen :i64] :i64
  ;; returns the index within the chunk of the wanted match, or -(seen+1) to
  ;; carry the running count out (a document cannot be returned alongside it)
  (if (>= k (document-count chunk))
    (- 0 (+ seen 1))
    (if (matches? (at-or-null chunk k) terms)
      (if (= seen want) k (match-in-chunk chunk terms want (+ k 1) (+ seen 1)))
      (match-in-chunk chunk terms want (+ k 1) seen))))

(defn- match-at-from [terms :document want :i64 c :i64 seen :i64] :document
  (if (>= c (registry-chunks))
    (document-null)
    (let [chunk (registry-chunk c)
          r (match-in-chunk chunk terms want 0 seen)]
      (if (>= r 0)
        (at-or-null chunk r)
        (match-at-from terms want (+ c 1) (- 0 (+ r 1)))))))

(defn match-at [terms :document nth :i64] :document
  (match-at-from terms nth 0 0))

;; ---------------------------------------------------------------------------
;; the HTTP request one invocation means
;; ---------------------------------------------------------------------------

(defn- error-doc [type :keyword message :string] :document
  (document-assoc (document-map) :error
                  (document-assoc (document-assoc (document-map) :type (document-keyword type))
                                  :message (document-string message))))

(defn- error-with [type :keyword message :string k :keyword v :document] :document
  (let [e (error-doc type message)]
    (document-assoc e :error (document-assoc (get-or-null e :error) k v))))

(defn- str-key [k :string] :document (document-string k))

(defn- get-by-str [d :document k :string] :document
  (option-or (document-get d (str-key k)) (document-null)))

;; `arguments` is keyed by STRING (the front end merges named flags,
;; positional arguments and the payload under the parameter's own name).
(defn- fill-template [template :string params :document args :document i :i64] :document
  ;; returns {:path … :remaining …} or {:error …}
  (if (>= i (document-count params))
    (document-assoc (document-assoc (document-map) :path (document-string template)) :remaining args)
    (let [nm (get-str (at-or-null params i) :name "")
          v (get-by-str args nm)]
      (if (present? v)
        (fill-template (string-replace-all template (cat3 "{" nm "}") (url-encode (value-text v)))
                       params (document-dissoc args (str-key nm)) (+ i 1))
        (error-with :commands/missing-parameter
                    (cat4 "--" nm " が必要です（" (string-concat template "）"))
                    :parameter (document-string nm))))))

(defn- query-from [m :document i :i64 acc :string] :string
  (if (>= i (document-count m))
    acc
    (let [e (entry-at m i)
          k (value-text (at-or-null e 0))
          v (value-text (at-or-null e 1))
          pair (cat3 (url-encode k) "=" (url-encode v))]
      (query-from m (+ i 1) (if (= i 0) pair (cat3 acc "&" pair))))))

;; the string-keyed remainder as the keyword-keyed JSON body the server reads
(defn- keywordize [m :document i :i64 acc :document] :document
  (if (>= i (document-count m))
    acc
    (let [e (entry-at m i)]
      (keywordize m (+ i 1)
                  (document-assoc acc (keyword-from-string (value-text (at-or-null e 0))) (at-or-null e 1))))))

;; Path parameters come out of `arguments` by name; everything left over is
;; the query string for a read and the JSON body for a write.
(defn request [command :document arguments :document body-override :document] :document
  (let [method (get-str command :method "GET")
        filled (fill-template (get-str command :template "") (get-or-null command :params) arguments 0)]
    (if (present? (get-or-null filled :error))
      filled
      (let [path (get-str filled :path "")
            remaining (get-or-null filled :remaining)
            read? (string=? method "GET")
            out (document-assoc (document-map) :method
                                (document-keyword (keyword-from-string (string-fold-case method))))]
        (if read?
          (document-assoc
           (document-assoc out :path
                           (document-string (if (> (document-count remaining) 0)
                                              (cat3 path "?" (query-from remaining 0 ""))
                                              path)))
           :body (document-null))
          (document-assoc (document-assoc out :path (document-string path))
                          :body (document-merge (keywordize remaining 0 (document-map)) body-override)))))))

;; ---------------------------------------------------------------------------
;; alias requests — the reviewed table's body specs
;; ---------------------------------------------------------------------------

(defn- spec? [d :document] :bool
  (if (= :map (document-kind d))
    (if (document-contains d :flag) true (document-contains d :enrollment-key))
    false))

(defn- space-byte? [cp :i64] :bool (<= cp 32))

;; byte offset of the first non-space code point at or after `i`
(defn- left-edge [s :string i :i64] :i64
  (if (>= i (string-length s))
    i
    (let [cp (string-code-point-at s i)]
      (if (space-byte? cp) (left-edge s (+ i (cp-width cp))) i))))

;; byte offset just past the last non-space code point, scanning forward
(defn- right-edge [s :string i :i64 last-end :i64] :i64
  (if (>= i (string-length s))
    last-end
    (let [cp (string-code-point-at s i)
          next (+ i (cp-width cp))]
      (right-edge s next (if (space-byte? cp) last-end next)))))

(defn- trim [s :string] :string
  ;; ASCII whitespace at both ends, which is what the comma-list parse trimmed.
  (let [a (left-edge s 0)
        b (right-edge s a a)]
    (string-substring s a b)))

;; `string-index-of` is not qualified on wasm32 (measured 2026-09-15), so the
;; comma is found by code point.
(defn- index-of-cp [s :string cp :i64 i :i64] :i64
  (if (>= i (string-length s))
    -1
    (let [here (string-code-point-at s i)]
      (if (= cp here) i (index-of-cp s cp (+ i (cp-width here)))))))

(defn- comma-list-from [s :string acc :document] :document
  (let [i (index-of-cp s 44 0)]
    (if (< i 0)
      (let [t (trim s)]
        (if (blank? t) acc (document-vector-conj acc (document-string t))))
      (let [t (trim (string-substring s 0 i))]
        (comma-list-from (string-substring s (+ i 1) (string-length s))
                         (if (blank? t) acc (document-vector-conj acc (document-string t))))))))

(defn- digits-from [s :string i :i64 acc :i64] :i64
  (if (>= i (string-length s))
    acc
    (let [cp (string-code-point-at s i)]
      (if (and (>= cp 48) (<= cp 57))
        (digits-from s (+ i 1) (+ (* acc 10) (- cp 48)))
        -1))))   ; a non-digit code point ends the parse; its width does not matter

;; `parse-long` on a string of digits with an optional leading `-`; anything
;; else is null, as `parse-long` returned nil.
(defn- parse-long-doc [s :string] :document
  (if (blank? s)
    (document-null)
    (if (= 45 (string-code-point-at s 0))
      (let [n (digits-from s 1 0)] (if (< n 0) (document-null) (document-i64 (- 0 n))))
      (let [n (digits-from s 0 0)] (if (< n 0) (document-null) (document-i64 n))))))

(defn- boolish? [raw :document] :bool
  (cond
    (truthy-flag? raw) true
    (= :string (document-kind raw))
    (let [s (str-or raw "")]
      (cond (string=? s "true") true (string=? s "1") true (string=? s "yes") true :else false))
    :else false))

;; the value a body leaf takes, `{:needs …}` when it takes an effect the host
;; has not supplied, or null for absent. `supplied` is
;; `{:file-contents {"<path>" "<text>"} :enrollment-key "<key>"}`.
(defn- coerce [raw :document parse :keyword supplied :document] :document
  (cond
    (= parse :none) raw
    (= parse :long) (parse-long-doc (value-text raw))
    (= parse :comma-list) (if (= :string (document-kind raw))
                            (comma-list-from (str-or raw "") (document-vector))
                            (document-null))
    (= parse :boolish) (document-bool (boolish? raw))
    (= parse :file-contents)
    (let [path (value-text raw)
          files (get-or-null supplied :file-contents)
          text (if (= :map (document-kind files))
                 (option-or (document-get files (document-string path)) (document-null))
                 (document-null))]
      (if (present? text)
        text
        (document-assoc (document-map) :needs
                        (document-assoc (document-map) :read-file (document-string path)))))
    :else (document-assoc (document-map) :needs
                          (document-assoc (document-map) :unknown-parse (document-keyword parse)))))

(defn- needs? [d :document] :bool
  (if (= :map (document-kind d)) (document-contains d :needs) false))

(defn- leaf-value [flags :document spec :document supplied :document] :document
  ;; a spec leaf: {:flag k :required? bool :default x :parse p} or {:enrollment-key true}
  (if (document-contains spec :enrollment-key)
    (let [key (get-or-null supplied :enrollment-key)]
      (if (present? key)
        key
        (document-assoc (document-map) :needs (document-keyword :enrollment-key))))
    (let [flag (kw-or (get-or-null spec :flag) :none)
          raw (let [v (get-or-null flags flag)]
                (if (present? v) v (get-or-null spec :default)))
          required? (option-or (document-bool-value (get-or-null spec :required?)) false)]
      (if (present? raw)
        (coerce raw (kw-or (get-or-null spec :parse) :none) supplied)
        (if required?
          (error-with :commands/missing-argument
                      (cat3 "--" (keyword-name flag) " が必要です")
                      :flag (document-keyword flag))
          (document-null))))))

;; A nested body object is built key by key; a leaf that is absent drops its
;; key, and an object whose every leaf was absent drops itself, because the
;; server reads a present-but-empty key as an instruction.
(defn- build-body [flags :document spec :document supplied :document i :i64 acc :document] :document
  (if (>= i (document-count spec))
    acc
    (let [e (entry-at spec i)
          k (kw-or (at-or-null e 0) :none)
          sub (at-or-null e 1)
          v (if (spec? sub)
              (leaf-value flags sub supplied)
              (let [nested (build-body flags sub supplied 0 (document-map))]
                (if (present? (get-or-null nested :error))
                  nested
                  (if (needs? nested)
                    nested
                    (if (> (document-count nested) 0) nested (document-null))))))]
      (cond
        (not (present? v)) (build-body flags spec supplied (+ i 1) acc)
        (= :map (document-kind v))
        (if (document-contains v :error)
          v
          (if (document-contains v :needs)
            v
            (build-body flags spec supplied (+ i 1) (document-assoc acc k v))))
        :else (build-body flags spec supplied (+ i 1) (document-assoc acc k v))))))

(defn- alias-path [template :string params :document flags :document i :i64] :document
  ;; {:path …} or {:error …}; an alias without :params has none to fill
  (if (>= i (count-or-zero params))
    (document-assoc (document-map) :path (document-string template))
    (let [p (at-or-null params i)
          nm (get-str p :name "")
          flag (kw-or (get-or-null p :flag) :none)
          v (let [x (get-or-null flags flag)] (if (present? x) x (get-or-null p :default)))
          required? (option-or (document-bool-value (get-or-null p :required?)) false)
          hint (get-or-null p :hint)]
      (if (present? v)
        (alias-path (string-replace-all template (cat3 "{" nm "}") (url-encode (value-text v)))
                    params flags (+ i 1))
        (error-with :commands/missing-argument
                    (if (and required? (present? hint))
                      (cat4 "--" (keyword-name flag) " が必要です（" (string-concat (str-or hint "") "）"))
                      (cat3 "--" (keyword-name flag) " が必要です"))
                    :flag (document-keyword flag))))))

(defn- one-of-present? [built :document keys :document i :i64] :bool
  (if (>= i (document-count keys))
    false
    (if (document-contains built (kw-or (at-or-null keys i) :none))
      true
      (one-of-present? built keys (+ i 1)))))

(defn- one-of-names [keys :document i :i64 acc :string] :string
  (if (>= i (document-count keys))
    acc
    (let [nm (string-concat "--" (keyword-name (kw-or (at-or-null keys i) :none)))]
      (one-of-names keys (+ i 1) (if (= i 0) nm (cat3 acc " / " nm))))))

;; The HTTP request one alias invocation means, `{:needs …}` when it needs a
;; file's contents or the enrollment key the host has not supplied yet, or
;; `{:error …}` naming the flag.
(defn alias-request [alias :document flags :document supplied :document] :document
  (let [pathed (alias-path (get-str alias :template "") (get-or-null alias :params) flags 0)]
    (if (present? (get-or-null pathed :error))
      pathed
      (let [body-spec (get-or-null alias :body)
            built (if (= :map (document-kind body-spec))
                    (build-body flags body-spec supplied 0 (document-map))
                    (document-map))]
        (cond
          (present? (get-or-null built :error)) built
          (needs? built) built
          :else
          (let [requires (get-or-null alias :requires-one-of)
                method (kw-or (get-or-null alias :method) :get)
                timeout (get-or-null alias :timeout-seconds)]
            (if (and (= :vector (document-kind requires))
                     (> (document-count requires) 0)
                     (not (one-of-present? built requires 0)))
              (error-with :commands/missing-argument
                          (string-concat "次のいずれかを指定してください: " (one-of-names requires 0 ""))
                          :requires-one-of requires)
              (let [base (document-assoc (document-assoc (document-map) :method (document-keyword method))
                                         :path (get-or-null pathed :path))
                    with-body (if (= method :post) (document-assoc base :body built) base)]
                (if (present? timeout) (document-assoc with-body :timeout-seconds timeout) with-body)))))))))

;; ---------------------------------------------------------------------------
;; tests — run by `amu test`, on every backend it hosts
;; ---------------------------------------------------------------------------

(defn- argv [text :string] :document (document-edn-read text))

(defn test-words [] :bool
  (let [ws (words (argv "[\"bots\" \"--label\" \"claude-code\" \"task\" \"--x\"]"))]
    (and (= 2 (document-count ws)) (string=? (str-at ws 1) "task"))))

(defn test-flags [] :bool
  (let [f (parse-flags (argv "[\"bots\" \"--label\" \"cli\" \"--dry\" \"--id\" \"7\"]"))]
    (and (string=? (get-str f :label "") "cli")
         (truthy-flag? (get-or-null f :dry))
         (string=? (get-str f :id "") "7"))))

(defn test-longest-wins [] :bool
  ;; `workspace drive documents rename` must beat `workspace drive documents`
  (let [r (resolve-command (argv "[\"workspace\" \"drive\" \"documents\" \"rename\" \"doc-1\"]"))]
    (and (= 4 (document-count (get-or-null (get-or-null r :command) :command)))
         (= 1 (document-count (get-or-null r :rest))))))

(defn test-alias-shadows-registry [] :bool
  (= :alias (kw-or (get-or-null (resolve-invocation (argv "[\"business\" \"list\"]")) :kind) :none)))

(defn test-host-side-is-named [] :bool
  (= :host-side (kw-or (get-or-null (resolve-invocation (argv "[\"bots\" \"hygiene\"]")) :kind) :none)))

(defn test-unknown [] :bool
  (= :unknown (kw-or (get-or-null (resolve-invocation (argv "[\"no\" \"such\" \"thing\"]")) :kind) :none)))

(defn test-request-get [] :bool
  (let [r (resolve-invocation (argv "[\"session\" \"--project\" \"p 1\"]"))
        req (request (get-or-null r :command) (document {"project" "p 1"}) (document-map))]
    (and (= :get (kw-or (get-or-null req :method) :none))
         (string=? (get-str req :path "") "/api/session?project=p+1"))))

(defn test-request-post [] :bool
  (let [cmd (document {:command ["x"] :method "POST" :template "/api/x/{id}" :params [{:name "id"}] :flags []})
        req (request cmd (document {"id" "a/b" "note" "n"}) (document {:extra 1}))]
    (and (string=? (get-str req :path "") "/api/x/a%2Fb")
         (= :post (kw-or (get-or-null req :method) :none))
         (string=? (get-str (get-or-null req :body) :note "") "n")
         (= 1 (option-or (document-i64-value (get-or-null (get-or-null req :body) :extra)) 0)))))

(defn test-request-missing-parameter [] :bool
  (let [cmd (document {:command ["x"] :method "GET" :template "/api/x/{id}" :params [{:name "id"}] :flags []})
        req (request cmd (document-map) (document-map))]
    (= :commands/missing-parameter (kw-or (get-or-null (get-or-null req :error) :type) :none))))

(defn- sample-alias [] :document
  (document {:command ["bots" "task"] :method :post :template "/api/agent-bots/{id}/task"
             :params [{:name "id" :flag :id :required? true :hint "bots list で確認"}]
             :body {:text {:flag :text :required? true}
                    :n {:flag :n :parse :long}
                    :tags {:flag :tags :parse :comma-list}
                    :dry {:flag :dry :parse :boolish}
                    :meta {:label {:flag :label} :prompt {:flag :prompt-file :parse :file-contents}}}
             :timeout-seconds 120}))

(defn test-alias-request [] :bool
  (let [flags (parse-flags (argv "[\"--id\" \"b 1\" \"--text\" \"hi\" \"--n\" \"12\" \"--tags\" \"a, b,,c\" \"--dry\" \"--label\" \"L\"]"))
        r (alias-request (sample-alias) flags (document-map))
        body (get-or-null r :body)]
    (and (string=? (get-str r :path "") "/api/agent-bots/b+1/task")
         (= :post (kw-or (get-or-null r :method) :none))
         (= 120 (option-or (document-i64-value (get-or-null r :timeout-seconds)) 0))
         (string=? (get-str body :text "") "hi")
         (= 12 (option-or (document-i64-value (get-or-null body :n)) 0))
         (= 3 (document-count (get-or-null body :tags)))
         (option-or (document-bool-value (get-or-null body :dry)) false)
         (string=? (get-str (get-or-null body :meta) :label "") "L"))))

(defn test-alias-needs [] :bool
  (let [flags (parse-flags (argv "[\"--id\" \"b\" \"--text\" \"hi\" \"--prompt-file\" \"p.txt\"]"))
        r (alias-request (sample-alias) flags (document-map))
        again (alias-request (sample-alias) flags (document {:file-contents {"p.txt" "PROMPT"}}))]
    (and (string=? (get-str (get-or-null r :needs) :read-file "") "p.txt")
         (string=? (get-str (get-or-null (get-or-null again :body) :meta) :prompt "") "PROMPT"))))

(defn test-alias-required [] :bool
  (let [r (alias-request (sample-alias) (parse-flags (argv "[\"--text\" \"hi\"]")) (document-map))
        e (get-or-null r :error)]
    (and (= :commands/missing-argument (kw-or (get-or-null e :type) :none))
         (= :id (kw-or (get-or-null e :flag) :none))
         (string-contains? (get-str e :message "") "bots list で確認"))))

(defn test-usage [] :bool
  (string=? (usage (document {:command ["x" "y"] :params [{:name "id"}] :flags ["q"]}))
            "x y --id <id> [--q <value>]"))

(defn test-match [] :bool
  (let [all (match-count (document-vector))
        some (match-count (argv "[\"BOTS\"]"))]
    (and (= all (registry-count))
         (> some 0)
         (< some all)
         (string-contains? (string-fold-case (command-name (match-at (argv "[\"bots\"]") 0))) "bots"))))

(defn test-url-encode [] :bool
  (and (string=? (url-encode "a b/c?d=é*") "a+b%2Fc%3Fd%3D%C3%A9*")
       (string=? (url-encode "日本") "%E6%97%A5%E6%9C%AC")))

(defn test-comma-list [] :bool
  (= 2 (document-count (comma-list-from " a ,, b" (document-vector)))))

(defn test-boolish [] :bool
  (and (boolish? (document-string "yes")) (not (boolish? (document-string "no"))) (boolish? (document-bool true))))

(defn test-long [] :bool
  (and (= 42 (option-or (document-i64-value (parse-long-doc "42")) 0))
       (= -7 (option-or (document-i64-value (parse-long-doc "-7")) 0))
       (not (present? (parse-long-doc "4x")))))
