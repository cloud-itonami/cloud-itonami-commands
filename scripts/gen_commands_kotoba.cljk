#!/usr/bin/env kbb
;; scripts/gen_commands_kotoba.cljk — splice the two tables into the Kotoba
;; component.
;;
;;   kbb --backend sci scripts/gen_commands_kotoba.cljk           # write src/cloud/itonami/commands.kotoba
;;   kbb --backend sci scripts/gen_commands_kotoba.cljk --check   # exit 1 when the written file is stale
;;
;; The registry (`resources/cloud-itonami-app.commands.edn`, generated by the
;; app from its routes) and the alias table become `case` tables over an
;; index inside `commands.kotoba.in`'s marked sections. One artifact, one
;; CID: the code that resolves a command and the commands it resolves.
;;
;; Exit codes: 0 written / current; 1 stale (--check); 2 could not read an input.
(ns gen-commands-kotoba
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [nbb.core :refer [*file*]]))

(def here (path/resolve (path/dirname *file*) ".."))
(defn- root [& parts] (apply path/join here parts))

(defn- read-edn [rel]
  (let [p (root rel)]
    (when-not (fs/existsSync p)
      (println "REFUSED: input missing:" p)
      (js/process.exit 2))
    (edn/read-string (fs/readFileSync p "utf8"))))

(defn- kotoba-literal
  "An EDN value as `(document-edn-read \"…\")` — its own EDN text, read at
  access time. Not a `(document …)` literal: the wasm host admits 256 typed
  ABI literals per module and the registry alone is 211 (measured
  2026-09-15, `too many typed ABI literals` at instantiation). pr-str is
  enough for the closed vocabulary these tables use (strings, keywords,
  booleans, integers, vectors, maps); a value outside it is refused by name
  rather than emitted."
  [v]
  (letfn [(ok? [x] (cond (or (string? x) (keyword? x) (boolean? x) (integer? x) (nil? x)) true
                         (vector? x) (every? ok? x)
                         (map? x) (and (every? keyword? (keys x)) (every? ok? (vals x)))
                         :else false))]
    (when-not (ok? v)
      (println "REFUSED: table value outside the document vocabulary:" (pr-str v))
      (js/process.exit 2))
    (str "(document-edn-read " (pr-str (pr-str v)) ")")))

(def chunk 8)

(defn- chunk-table
  "`(defn <prefix>-chunk [c :i64] :document (case c 0 (document-edn-read \"[…8 commands…]\") …))`
  plus `<prefix>-count`. Eight per chunk keeps a chunk under the 256-node
  document budget (a projected command is ~14 nodes), and the whole table
  under the browser host's 256 typed-literal budget: one literal per chunk,
  not one per command, not one per word (measured 2026-09-15: 300 distinct
  string literals in one module -> `too many typed ABI literals` at
  instantiation). A `case` desugars to nested `if`s, so the outer case is
  itself chunked by 16 when there are more than 16 chunks."
  [prefix commands]
  (let [groups (partition-all chunk commands)
        literals (map (fn [g] (kotoba-literal (vec g))) groups)
        n (count literals)
        inner (for [[k es] (map-indexed vector (partition-all 16 (map-indexed vector literals)))]
                (str "(defn- " prefix "-chunk-c" k " [c :i64] :document\n  (case c"
                     (apply str (map (fn [[i v]] (str "\n    " i " " v)) es))
                     "\n    (document-null)))\n"))
        outer (str "(defn " prefix "-chunk [c :i64] :document\n  (case (quot c 16)"
                   (apply str (map (fn [k] (str "\n    " k " (" prefix "-chunk-c" k " c)")) (range (count inner))))
                   "\n    (document-null)))\n")]
    (str "(defn " prefix "-count [] :i64 " (count commands) ")\n"
         "(defn- " prefix "-chunks [] :i64 " n ")\n\n"
         (apply str (interpose "\n" inner)) "\n" outer)))

(defn- project
  "The keys a front end reads (measured against cloud-itonami-cli bin/itonami
  2026-09-15: command / method / template / params names / flags for the
  registry, plus body / requires-one-of / timeout-seconds / stores-token?
  for an alias and why for a host-side entry). The rest -- :gate, :route,
  :note, a param's :in -- stays in the EDN tables, which remain the contract
  the JVM and mobile consumers read; the module's string budget is 64 KiB
  and the full registry is 95 KB."
  [prefix c]
  (case prefix
    "registry" (-> (select-keys c [:command :method :template :flags])
                   (assoc :params (mapv #(select-keys % [:name]) (:params c))))
    "alias" (select-keys c [:command :method :template :params :body :requires-one-of
                            :timeout-seconds :stores-token?])
    "host-side" (select-keys c [:command :why])))

(defn- table-section [prefix commands]
  (chunk-table prefix (map #(project prefix %) commands)))

(defn- render []
  (let [registry (read-edn "resources/cloud-itonami-app.commands.edn")
        aliases (read-edn "resources/cloud-itonami-app.cli-aliases.edn")
        template (fs/readFileSync (root "src/cloud/itonami/commands.kotoba.in") "utf8")
        reg (str ";; registry: " (count (:commands registry)) " commands, "
                 (pr-str (:counts registry)) "\n"
                 (table-section "registry" (:commands registry))
                 "\n(defn counts [] :document " (kotoba-literal (:counts registry)) ")\n")
        ali (str ";; aliases: " (count (:commands aliases)) " commands, "
                 (count (:host-side aliases)) " host-side\n"
                 (table-section "alias" (:commands aliases))
                 "\n"
                 (table-section "host-side" (:host-side aliases)))
        out (-> template
                (str/replace ";;@registry" reg)
                (str/replace ";;@aliases" ali))]
    (when (or (str/includes? out ";;@registry") (str/includes? out ";;@aliases"))
      (println "REFUSED: template markers were not both replaced")
      (js/process.exit 2))
    out))

(let [args (set (drop 3 (js->clj js/process.argv)))
      target (root "src/cloud/itonami/commands.kotoba")
      out (render)]
  (if (contains? args "--check")
    (let [current (try (fs/readFileSync target "utf8") (catch :default _ nil))]
      (if (= current out)
        (println "commands.kotoba is current")
        (do (println "STALE:" target "does not match the tables and template; run scripts/gen_commands_kotoba.cljk")
            (js/process.exit 1))))
    (do (fs/writeFileSync target out)
        (println "wrote" target (count out) "bytes"))))
